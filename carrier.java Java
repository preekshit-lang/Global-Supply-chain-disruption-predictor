package model;

public class carrier extends item {
    private String mode;

    public carrier(String id, String name, String mode) {
        super(id, name);
        this.mode = mode;
    }

    public String getmode() {
        return mode;
    }

    public String toString() {
        return "[" + id + "] " + name + " (mode: " + mode + ")";
    }
}
